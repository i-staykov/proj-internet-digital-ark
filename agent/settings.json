{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(reboot*)",
      "Bash(shutdown*)",
      "Bash(just hold off*)",
      "Bash(just ship*)",
      "Bash(just prune*)",
      "Bash(claude setup-token*)",
      "Bash(claude login*)",
      "Bash(printenv*)",
      "Bash(crontab *)",
      "Read(~/ark/data/held/**)",
      "Read(~/ark/ding/**)",
      "Read(~/ark/private/**)",
      "Read(~/ark/local.env)",
      "Read(~/.config/ark/**)",
      "Read(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Edit(~/ark/agent/**)",
      "Edit(~/ark/.claude/**)",
      "Edit(~/ark/hooks/**)",
      "Edit(~/ark/.github/**)",
      "Edit(~/ark/AGENTS.md)",
      "Edit(~/ark/src/ark/hygiene.py)",
      "Edit(~/ark/scripts/harness/hold.sh)",
      "Edit(~/ark/scripts/harness/sync_lock.sh)",
      "Edit(~/ark/scripts/agents/rails.py)",
      "Edit(~/ark/data/held/**)",
      "Edit(~/ark/ding/**)",
      "Edit(~/ark/submissions/**)",
      "Edit(~/ark/private/**)",
      "Edit(~/ark/local.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/agents/rails.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
